# Compiled Python bytecode cache — never commit this. Stale .pyc files can
# get loaded instead of freshly-compiled source depending on the interpreter's
# cache-invalidation mode, silently masking real source changes.
__pycache__/
*.pyc
*.pyo

# Local-only auth token for update_game.py / session scripts — never commit.
.gh_token

# update_game.py bookkeeping (which character files it last wrote) — local only.
.sync_state.json

# Written by the game at run time (sprite bake cache, roster thumbnails, logs).
characters/_baked/
characters/*_thumb.png
laser_cursor_error.log
laser_cursor_log.txt
